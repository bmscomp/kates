{
  "name": "assess_run",
  "title": "Assess a test run",
  "description": "Judges one finished run: regression against its baseline, a noise band over earlier runs of the same spec, the change from the last of them, broker skew and advisor rules. Reading an active run makes the backend poll it. Only reads. Full description and every result field: kates://docs/mcp/assess_run.",
  "annotations": {
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Assess a test run"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "band_runs": {
        "description": "how many earlier same-spec runs the noise band may use, 3 to 20 (default 10)",
        "maximum": 20,
        "minimum": 3,
        "type": "integer"
      },
      "run_id": {
        "description": "the test run id, from list_runs",
        "pattern": "^[0-9a-f]{8}$",
        "type": "string"
      }
    },
    "required": [
      "run_id"
    ],
    "type": "object"
  },
