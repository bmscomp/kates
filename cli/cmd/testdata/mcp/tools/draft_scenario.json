{
  "name": "draft_scenario",
  "title": "Draft a test scenario",
  "description": "Checks a load-test scenario (YAML, or a built-in template with overrides) against what kates test apply and the backend accept and the proposed agent envelope. Saves, starts and sends nothing. Only reads. Full description and every result field: kates://docs/mcp/draft_scenario.",
  "annotations": {
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Draft a test scenario"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "name": {
        "description": "a new name for every scenario in the file",
        "maxLength": 200,
        "type": "string"
      },
      "spec_overrides": {
        "additionalProperties": true,
        "description": "spec keys to set in every scenario, named as scenario files name them (records, parallelProducers, recordSizeBytes, durationSeconds, topic, partitions, ...); each a number, text or true/false",
        "maxProperties": 30,
        "type": "object"
      },
      "template": {
        "description": "a built-in scenario template to start from, as listed under kates://scenarios/. Give this or yaml",
        "enum": [
          "quick-load",
          "production-load",
          "stress-test",
          "endurance-soak",
          "exactly-once",
          "integrity-tx",
          "spike-test",
          "ci-gate"
        ],
        "type": "string"
      },
      "validate_overrides": {
        "additionalProperties": {
          "type": "number"
        },
        "description": "validate thresholds to set in every scenario (maxP99LatencyMs, maxAvgLatencyMs, minThroughputRecPerSec, maxDataLossPercent, ...)",
        "maxProperties": 20,
        "type": "object"
      },
      "yaml": {
        "description": "a scenario file as kates test apply -f reads it: a scenarios list of name, type, spec and validate, or one such scenario at its top level. JSON is checked both as kates test apply reads a .json file and as YAML, and must read the same both ways. Give this or template",
        "maxLength": 8000,
        "type": "string"
      }
    },
    "type": "object"
  },
  "outputSchema": {
    "properties": {
      "caveats": {
        "items": {
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "text"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "cluster": {
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "type": "object"
      },
      "data": {
        "properties": {
          "envelope": {
            "properties": {
              "maxBytes": {
                "type": "integer"
              },
              "maxDurationMs": {
                "type": "integer"
              },
              "maxPartitions": {
                "type": "integer"
              },
              "maxRecordsPerSecond": {
                "type": "integer"
              },
              "maxStressProducers": {
                "type": "integer"
              },
              "source": {
                "type": "string"
              },
              "topicPrefix": {
                "type": "string"
              },
              "types": {
                "items": {
                  "type": "string"
                },
                "type": [
                  "null",
                  "array"
                ]
              }
            },
            "required": [
              "types",
              "maxStressProducers",
              "maxRecordsPerSecond",
              "maxBytes",
              "maxDurationMs",
              "maxPartitions",
              "topicPrefix",
              "source"
            ],
            "type": "object"
          },
          "findings": {
            "items": {
              "properties": {
                "field": {
                  "type": "string"
                },
                "level": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "scenario": {
                  "type": "integer"
                }
              },
              "required": [
                "scenario",
                "level",
                "message"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "scenarios": {
            "items": {
              "properties": {
                "effective": {
                  "properties": {
                    "bytes": {
                      "type": "number"
                    },
                    "defaulted": {
                      "items": {
                        "type": "string"
                      },
                      "type": [
                        "null",
                        "array"
                      ]
                    },
                    "durationMs": {
                      "type": "integer"
                    },
                    "numProducers": {
                      "type": "integer"
                    },
                    "numRecords": {
                      "type": "integer"
                    },
                    "partitions": {
                      "type": "integer"
                    },
                    "producerTasks": {
                      "type": "integer"
                    },
                    "recordSize": {
                      "type": "integer"
                    },
                    "recordsPerSecond": {
                      "type": "number"
                    },
                    "throughput": {
                      "type": "integer"
                    },
                    "topic": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "topic",
                    "numRecords",
                    "recordSize",
                    "numProducers",
                    "producerTasks",
                    "throughput",
                    "durationMs",
                    "partitions",
                    "recordsPerSecond",
                    "bytes",
                    "defaulted"
                  ],
                  "type": [
                    "null",
                    "object"
                  ]
                },
                "index": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "request": {
                  "properties": {
                    "backend": {
                      "type": "string"
                    },
                    "spec": {
                      "properties": {
                        "acks": {
                          "type": "string"
                        },
                        "batchSize": {
                          "type": [
                            "null",
                            "integer"
                          ]
                        },
                        "compressionType": {
                          "type": "string"
                        },
                        "consumerGroup": {
                          "type": "string"
                        },
                        "durationMs": {
                          "type": "integer"
                        },
                        "enableCrc": {
                          "type": [
                            "null",
                            "boolean"
                          ]
                        },
                        "enableIdempotence": {
                          "type": [
                            "null",
                            "boolean"
                          ]
                        },
                        "enableTransactions": {
                          "type": [
                            "null",
                            "boolean"
                          ]
                        },
                        "fetchMaxWaitMs": {
                          "type": [
                            "null",
                            "integer"
                          ]
                        },
                        "fetchMinBytes": {
                          "type": "integer"
                        },
                        "lingerMs": {
                          "type": [
                            "null",
                            "integer"
                          ]
                        },
                        "minInsyncReplicas": {
                          "type": "integer"
                        },
                        "numConsumers": {
                          "type": "integer"
                        },
                        "numProducers": {
                          "type": "integer"
                        },
                        "numRecords": {
                          "type": "integer"
                        },
                        "partitions": {
                          "type": "integer"
                        },
                        "recordSize": {
                          "type": "integer"
                        },
                        "replicationFactor": {
                          "type": "integer"
                        },
                        "targetThroughput": {
                          "type": "integer"
                        },
                        "throughput": {
                          "type": "integer"
                        },
                        "topic": {
                          "type": "string"
                        }
                      },
                      "type": [
                        "null",
                        "object"
                      ]
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "index",
                "name",
                "request"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "verdict": {
            "type": "string"
          },
          "yaml": {
            "type": "string"
          },
          "yamlOmitted": {
            "type": "boolean"
          }
        },
        "required": [
          "verdict",
          "scenarios",
          "findings",
          "envelope"
        ],
        "type": "object"
      },
      "tier": {
        "type": "string"
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "cluster",
      "tier",
      "caveats",
      "truncated",
      "data"
    ],
    "type": "object"
  }
}
