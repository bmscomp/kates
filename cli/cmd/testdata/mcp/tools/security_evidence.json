{
  "name": "security_evidence",
  "title": "Security evidence",
  "description": "Lab security posture and drift from the Kates checks; not audit evidence. Each posture, compliance or drift read runs a fresh audit, which the backend's in-memory grade history records: page with problems_only and limit 50. Only reads. Full description and every result field: kates://docs/mcp/security_evidence.",
  "annotations": {
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Security evidence"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "framework": {
        "description": "with section compliance: cis, soc2 or pci, to list that framework's controls; without it only the totals",
        "enum": [
          "cis",
          "soc2",
          "pci"
        ],
        "type": "string"
      },
      "limit": {
        "description": "most items to return (default 20); fewer come back when they would not fit one result",
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "description": "first item of the section's list to return, from page.nextOffset of the previous call",
        "minimum": 0,
        "type": "integer"
      },
      "problems_only": {
        "description": "keep only what is not passing: checks not PASS, pentest entries VULNERABLE, CVE entries not PATCHED, drift that changed, config keys that differ",
        "type": "boolean"
      },
      "section": {
        "description": "summary (the default), or one check in detail: posture, pentest, compliance, tls, certs, cve, drift, config_diff (configDiff in a summary)",
        "enum": [
          "summary",
          "posture",
          "pentest",
          "compliance",
          "tls",
          "certs",
          "cve",
          "drift",
          "config_diff"
        ],
        "type": "string"
      }
    },
    "type": "object"
  },
