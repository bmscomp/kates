{
  "name": "disruption_report",
  "title": "Disruption report",
  "description": "Explains one disruption: status, SLA verdict, summary, each step's fault, recovery times and metric changes (paged), the impact score, and with baseline_id the change from another run. Only reads. Full description and every result field: kates://docs/mcp/disruption_report.",
  "annotations": {
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Disruption report"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "baseline_id": {
        "description": "another disruption id to compare with, such as an earlier run of the same plan",
        "pattern": "^[0-9a-f]{8}$",
        "type": "string"
      },
      "disruption_id": {
        "description": "the disruption id, as kates disruption list prints it",
        "pattern": "^[0-9a-f]{8}$",
        "type": "string"
      },
      "limit": {
        "description": "most steps to list, 1 to 50 (default 10)",
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "description": "the first step to list, counted from 0 (default 0); pass nextOffset from the previous result for the next page",
        "maximum": 10000,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "disruption_id"
    ],
    "type": "object"
  },
