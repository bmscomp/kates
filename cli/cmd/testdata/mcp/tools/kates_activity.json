{
  "name": "kates_activity",
  "title": "Kates activity",
  "description": "What Kates is running and recorded since a time (default 1h): unfinished runs, new runs, disruption reports and audit rows naming who acted. Call it first when asking whether Kates caused something. Only reads. Full description and every result field: kates://docs/mcp/kates_activity.",
  "annotations": {
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Kates activity"
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "limit": {
        "description": "most items in each list, 1 to 30 (default 15)",
        "maximum": 30,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "description": "the first item of each list to return, counted from 0 (default 0); pass the list's nextOffset from the previous result for its next page",
        "maximum": 170,
        "minimum": 0,
        "type": "integer"
      },
      "since": {
        "description": "an RFC 3339 time, a duration back from now such as 30m or 2h, or a clock time HH:MM or HH:MM:SS, meaning its latest occurrence in the server's time zone (default 1h)",
        "type": "string"
      }
    },
    "type": "object"
  },
