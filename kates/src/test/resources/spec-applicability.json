{
  "about": "Which requested spec fields the backend refuses for a test type and backend (TestOrchestrator.inapplicableFields). kates mcp's draft_scenario keeps its own copy of the rules (cli/cmd/mcp_tools_scenario.go, mcpScnCheckApplies); TestOrchestratorTest and TestMCPDraftScenarioRulesMatchTheBackend both run these cases, so the two cannot drift apart. No value is 0: the CLI leaves a 0 out of the request, so the backend never sees it.",
  "cases": [
    {"name": "a producer and a consumer take every field", "type": "LOAD",
     "spec": {"acks": "all", "targetThroughput": 1000, "consumerGroup": "perf-cg", "fetchMinBytes": 1024, "fetchMaxWaitMs": 100, "enableIdempotence": true, "enableTransactions": true},
     "refused": []},
    {"name": "endurance takes the consumer settings", "type": "ENDURANCE",
     "spec": {"consumerGroup": "soak-cg", "fetchMinBytes": 65536, "fetchMaxWaitMs": 500, "throughput": 2000},
     "refused": []},
    {"name": "integrity takes the CRC option", "type": "INTEGRITY",
     "spec": {"consumerGroup": "integrity-cg", "enableCrc": false, "enableIdempotence": true, "enableTransactions": true},
     "refused": []},
    {"name": "no consumer, no consumer settings", "type": "STRESS",
     "spec": {"consumerGroup": "perf-cg", "fetchMinBytes": 1024, "fetchMaxWaitMs": 100},
     "refused": ["consumerGroup", "fetchMinBytes", "fetchMaxWaitMs"]},
    {"name": "volume starts no consumer", "type": "VOLUME",
     "spec": {"consumerGroup": "volume-cg", "fetchMinBytes": 1048576},
     "refused": ["consumerGroup", "fetchMinBytes"]},
    {"name": "round trip starts no separate consumer", "type": "ROUND_TRIP",
     "spec": {"fetchMaxWaitMs": 50, "throughput": 5000},
     "refused": ["fetchMaxWaitMs"]},
    {"name": "tuning starts no consumer", "type": "TUNE_ACKS",
     "spec": {"fetchMinBytes": 1},
     "refused": ["fetchMinBytes"]},
    {"name": "spike runs unthrottled", "type": "SPIKE",
     "spec": {"targetThroughput": 500, "throughput": 500},
     "refused": ["throughput", "targetThroughput"]},
    {"name": "capacity takes the unlimited rate it runs at", "type": "CAPACITY",
     "spec": {"targetThroughput": -1, "throughput": -1},
     "refused": []},
    {"name": "only integrity checks CRCs", "type": "ROUND_TRIP",
     "spec": {"enableCrc": true},
     "refused": ["enableCrc"]},
    {"name": "turning off a CRC check nobody makes asks for nothing", "type": "LOAD",
     "spec": {"enableCrc": false},
     "refused": []},
    {"name": "idempotence needs acks all, and spike's default is 1", "type": "SPIKE",
     "spec": {"enableIdempotence": true},
     "refused": ["enableIdempotence"]},
    {"name": "idempotence with acks all", "type": "SPIKE",
     "spec": {"enableIdempotence": true, "acks": "all"},
     "refused": []},
    {"name": "transactions need acks all", "type": "LOAD",
     "spec": {"acks": "1", "enableTransactions": true},
     "refused": ["enableTransactions"]},
    {"name": "transactions are idempotent", "type": "LOAD",
     "spec": {"enableTransactions": true, "enableIdempotence": false},
     "refused": ["enableTransactions"]},
    {"name": "trogdor runs no transactional producer", "type": "LOAD", "backend": "trogdor",
     "spec": {"enableTransactions": true, "consumerGroup": "perf-cg"},
     "refused": ["enableTransactions"]},
    {"name": "cdc runs no Kates producer", "type": "INTEGRATION_CDC",
     "spec": {"targetThroughput": 500, "enableIdempotence": true, "enableTransactions": true, "consumerGroup": "cdc-cg"},
     "refused": ["targetThroughput", "consumerGroup", "enableIdempotence", "enableTransactions"]},
    {"name": "cdc takes the values that ask for nothing", "type": "INTEGRATION_CDC",
     "spec": {"targetThroughput": -1, "throughput": -1, "enableIdempotence": false, "enableTransactions": false, "enableCrc": false},
     "refused": []}
  ]
}
