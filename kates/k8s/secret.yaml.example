# Template for the 'kates-secrets' Secret — NOT applied automatically.
# Create it before deploying (the app refuses to start without a real API key):
#
#   kubectl create secret generic kates-secrets -n kates \
#     --from-literal=KATES_API_KEY="$(openssl rand -base64 32)" \
#     --from-literal=QUARKUS_DATASOURCE_USERNAME=kates \
#     --from-literal=QUARKUS_DATASOURCE_PASSWORD="$(openssl rand -base64 24)"
#
# The same POSTGRES_USER/POSTGRES_PASSWORD values are consumed by
# k8s/postgres.yaml, and QUARKUS_DATASOURCE_* by k8s/deployment.yaml.
# In GitOps setups, source this Secret from your secrets operator
# (external-secrets, sealed-secrets) instead of applying a file.
apiVersion: v1
kind: Secret
metadata:
  name: kates-secrets
  namespace: kates
  labels:
    app: kates
    app.kubernetes.io/name: kates
    app.kubernetes.io/part-of: kates
type: Opaque
stringData:
  KATES_API_KEY: "REPLACE-WITH-STRONG-RANDOM-VALUE"
  QUARKUS_DATASOURCE_USERNAME: "kates"
  QUARKUS_DATASOURCE_PASSWORD: "REPLACE-WITH-STRONG-RANDOM-VALUE"
