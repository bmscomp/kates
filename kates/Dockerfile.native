# Stage 1: Build the KATES CLI (Go)
# golang base pinned by digest (multi-arch manifest list). The mandrel builder
# (quay.io) and ubi-minimal runtime (registry.access.redhat.com) below are left
# tag-pinned: their digests need a quay/RedHat registry lookup, best handled by
# Renovate/Dependabot which resolves all three registries automatically.
FROM golang:1.25-alpine@sha256:8d22e29d960bc50cd025d93d5b7c7d220b1ee9aa7a239b3c8f55a57e987e8d45 AS cli-builder
ENV GOTOOLCHAIN=auto
WORKDIR /cli
COPY cli/go.mod cli/go.sum ./
RUN go mod download
COPY cli/ ./
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
  -trimpath \
  -ldflags="-s -w \
  -X github.com/bmscomp/kates/cli/cmd.Version=1.0.0 \
  -X github.com/bmscomp/kates/cli/cmd.BuildDate=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  -o /kates-cli .

# Stage 2: Build the native executable (Mandrel)
FROM quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-21 AS builder
USER root
WORKDIR /build

COPY kates/pom.xml .
COPY kates/.mvn .mvn
COPY kates/mvnw .
RUN --mount=type=cache,target=/root/.m2 \
  chmod +x mvnw && ./mvnw dependency:go-offline -B 2>/dev/null || true

COPY kates/src src
RUN --mount=type=cache,target=/root/.m2 \
  ./mvnw package -Dnative -DskipTests -B -Dquarkus.native.additional-build-args="-J-Xmx8g" \
  && mv target/*-runner target/kates-native

# Extract platform-specific JNI native libraries from Maven JARs
RUN --mount=type=cache,target=/root/.m2 \
  ARCH=$(uname -m) && \
  if [ "$ARCH" = "x86_64" ]; then JNI_ARCH="amd64"; SNAPPY_ARCH="linux/x86_64"; \
  elif [ "$ARCH" = "aarch64" ]; then JNI_ARCH="aarch64"; SNAPPY_ARCH="linux/aarch64"; \
  else JNI_ARCH="$ARCH"; SNAPPY_ARCH="linux/$ARCH"; fi && \
  mkdir -p /build/native-libs && \
  ZSTD_JAR=$(find /root/.m2/repository/com/github/luben/zstd-jni -name "*.jar" | sort -V | tail -1) && \
  LZ4_JAR=$(find /root/.m2/repository/org/lz4/lz4-java -name "*.jar" | sort -V | tail -1) && \
  SNAPPY_JAR=$(find /root/.m2/repository/org/xerial/snappy/snappy-java -name "*.jar" | sort -V | tail -1) && \
  echo "=== Extracting native libs (arch=$JNI_ARCH) ===" && \
  if [ -n "$ZSTD_JAR" ]; then cd /tmp && jar xf "$ZSTD_JAR" "linux/$JNI_ARCH/" && cp -v linux/$JNI_ARCH/*.so /build/native-libs/ 2>/dev/null && cd /build/native-libs/ && for f in libzstd-jni-*.so; do [ -e "$f" ] && cp "$f" libzstd-jni.so; done || true; fi && \
  if [ -n "$LZ4_JAR" ]; then cd /tmp && jar xf "$LZ4_JAR" "linux/$JNI_ARCH/" 2>/dev/null || jar xf "$LZ4_JAR" "net/jpountz/util/linux/$JNI_ARCH/" 2>/dev/null && cp -v net/jpountz/util/linux/$JNI_ARCH/*.so /build/native-libs/ 2>/dev/null || cp -v linux/$JNI_ARCH/*.so /build/native-libs/ 2>/dev/null || true; fi && \
  if [ -n "$SNAPPY_JAR" ]; then cd /tmp && jar xf "$SNAPPY_JAR" "org/xerial/snappy/native/Linux/$JNI_ARCH/" 2>/dev/null || jar xf "$SNAPPY_JAR" "org/xerial/snappy/native/$SNAPPY_ARCH/" 2>/dev/null && cp -v org/xerial/snappy/native/Linux/$JNI_ARCH/*.so /build/native-libs/ 2>/dev/null || cp -v org/xerial/snappy/native/$SNAPPY_ARCH/*.so /build/native-libs/ 2>/dev/null || true; fi && \
  ls -la /build/native-libs/ && \
  for lib in zstd lz4 snappy; do \
    ls /build/native-libs/ | grep -qi "$lib" || { echo "FATAL: no $lib native library extracted into /build/native-libs"; exit 1; }; \
  done

# NOTE: the guard above fails the build if any compression JNI lib is missing.
# The per-command `|| true` in the extraction tolerates arch/path variation,
# so without this final check a broken extraction would silently ship an image
# that crashes the first time lz4/snappy/zstd compression is used at runtime.


# Stage 3: Minimal runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7
WORKDIR /app

COPY --from=builder /build/target/kates-native ./kates
COPY --from=builder /build/native-libs/ ./lib/
COPY --from=cli-builder /kates-cli /usr/local/bin/kates

RUN chmod +x kates \
  && microdnf install -y shadow-utils \
  && groupadd -r kates && useradd -r -g kates -d /home/kates kates \
  && mkdir -p /home/kates \
  && printf 'current-context: local\ncontexts:\n  local:\n    url: http://localhost:8080\n    output: table\n' > /home/kates/.kates.yaml \
  && chown -R kates:kates /home/kates \
  && microdnf clean all

USER kates
ENV HOME=/home/kates
ENV LD_LIBRARY_PATH=/app/lib

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD curl -sf http://localhost:8080/api/health || exit 1

ENTRYPOINT ["./kates"]

