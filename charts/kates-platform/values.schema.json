{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kafka-cluster": {
      "type": "object",
      "description": "Pass-through values for the kafka-cluster subchart (validated by the subchart itself)",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "kates": {
      "type": "object",
      "description": "Pass-through values for the kates subchart (validated by the subchart itself)",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "test": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "required": ["name"]
          }
        ]
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "mirror-maker2": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
