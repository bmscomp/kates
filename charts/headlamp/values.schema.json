{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": { "type": "string" },
                "rbacScope": { "type": "string", "enum": ["", "cluster", "namespace"], "description": "Default rbac.scope of every chart in an umbrella release." }
            }
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": {
            "type": "object",
            "properties": {
                "repository": { "type": "string" },
                "tag": { "type": "string" },
                "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
            }
        },
        "imagePullSecrets": { "type": "array" },
        "nameOverride": { "type": "string" },
        "fullnameOverride": { "type": "string" },
        "config": {
            "type": "object",
            "properties": {
                "inCluster": { "type": "boolean" },
                "baseURL": { "type": "string" },
                "pluginsDir": { "type": "string" }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": { "type": "boolean" },
                "annotations": { "type": "object" },
                "name": { "type": "string" },
                "automount": { "type": "boolean" }
            }
        },
        "rbac": {
            "type": "object",
            "properties": {
                "scope": { "type": "string", "enum": ["", "cluster", "namespace"], "description": "cluster (empty: global.rbacScope, then cluster) or namespace: a Role, nothing cluster-scoped." },
                "create": { "type": "boolean" },
                "rules": { "type": "array", "items": { "type": "object" } }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
                "port": { "type": "integer" },
                "annotations": { "type": "object" }
            }
        },
        "containerPort": { "type": "integer" },
        "securityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "resources": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "test": {
            "type": "object",
            "properties": {
                "image": { "type": "string", "minLength": 1 },
                "podSecurityContext": { "type": "object" },
                "securityContext": { "type": "object" },
                "resources": { "type": "object" }
            }
        }
    }
}
