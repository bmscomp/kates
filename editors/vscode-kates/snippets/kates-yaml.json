{
  "Kates Scenario File (LOAD / STRESS / ENDURANCE)": {
    "prefix": "kates-scenario",
    "description": "Scaffold a Kates performance test scenario file (kates test apply -f)",
    "body": [
      "# kates-schema: scenario",
      "scenarios:",
      "  - name: \"${1:Production Load Test}\"",
      "    type: ${2|LOAD,STRESS,SPIKE,ENDURANCE,VOLUME,CAPACITY,ROUND_TRIP,INTEGRITY,TUNE_REPLICATION,TUNE_ACKS,TUNE_BATCHING,TUNE_COMPRESSION,TUNE_PARTITIONS|}",
      "    backend: ${3|native,trogdor|}",
      "    spec:",
      "      records: ${4:500000}",
      "      parallelProducers: ${5:4}",
      "      recordSizeBytes: ${6:1024}",
      "      partitions: ${7:6}",
      "      replicationFactor: ${8:3}",
      "      minInsyncReplicas: ${9:2}",
      "      acks: \"${10|all,1,0|}\"",
      "      compressionType: ${11|lz4,zstd,snappy,gzip,none|}",
      "      enableIdempotence: true",
      "    validate:",
      "      maxP99LatencyMs: ${12:25.0}",
      "      minThroughputRecPerSec: ${13:20000}"
    ]
  },
  "Kates Data Integrity Scenario": {
    "prefix": "kates-scenario-integrity",
    "description": "Scaffold an end-to-end INTEGRITY scenario with CRC32, sequence ordering, and zero-loss SLA gates",
    "body": [
      "# kates-schema: scenario",
      "scenarios:",
      "  - name: \"${1:Zero-Loss Integrity Verification}\"",
      "    type: INTEGRITY",
      "    spec:",
      "      records: ${2:200000}",
      "      parallelProducers: ${3:2}",
      "      numConsumers: ${4:2}",
      "      recordSizeBytes: ${5:512}",
      "      partitions: ${6:6}",
      "      replicationFactor: 3",
      "      minInsyncReplicas: 2",
      "      acks: \"all\"",
      "      enableIdempotence: true",
      "      enableCrc: true",
      "    validate:",
      "      maxDataLossPercent: 0",
      "      maxOutOfOrder: 0",
      "      maxCrcFailures: 0",
      "      maxRtoMs: ${7:5000}"
    ]
  },
  "Kates Multi-Phase TestScenario": {
    "prefix": "kates-multiphase",
    "description": "Scaffold a multi-phase CreateTestRequest (WARMUP -> RAMP -> STEADY -> SPIKE -> COOLDOWN)",
    "body": [
      "# kates-schema: test-request",
      "backend: native",
      "scenario:",
      "  name: \"${1:Multi-Phase Qualification}\"",
      "  baseSpec:",
      "    topic: ${2:kates-multiphase}",
      "    partitions: 6",
      "    replicationFactor: 3",
      "    minInsyncReplicas: 2",
      "    recordSize: 1024",
      "    acks: \"all\"",
      "    compressionType: lz4",
      "    enableIdempotence: true",
      "  phases:",
      "    - name: \"Warmup\"",
      "      type: WARMUP",
      "      durationMs: 15000",
      "      specOverrides:",
      "        throughput: 5000",
      "    - name: \"Ramp Up\"",
      "      type: RAMP",
      "      durationMs: 30000",
      "      rampSteps: ${3:5}",
      "      specOverrides:",
      "        throughput: 25000",
      "    - name: \"Steady State\"",
      "      type: STEADY",
      "      durationMs: 60000",
      "      specOverrides:",
      "        throughput: 25000",
      "    - name: \"Cooldown\"",
      "      type: COOLDOWN",
      "      durationMs: 10000",
      "  sla:",
      "    p99LatencyMs: ${4:30.0}",
      "    minThroughputRecPerSec: ${5:15000}",
      "    maxErrorRatePercent: 0.0"
    ]
  },
  "Kates Flow Pipeline": {
    "prefix": "kates-flow",
    "description": "Scaffold a multi-step Kates flow pipeline (kates flow run -f)",
    "body": [
      "# kates-schema: flow",
      "name: \"${1:Release Qualification Flow}\"",
      "steps:",
      "  - name: \"${2:Baseline Load}\"",
      "    action: test",
      "    type: LOAD",
      "    spec:",
      "      numRecords: ${3:100000}",
      "      recordSize: 1024",
      "      partitions: 6",
      "      replicationFactor: 3",
      "      acks: \"all\"",
      "    gate:",
      "      minGrade: ${4|A,B,C,D,F|}",
      "      maxP99: ${5:25.0}",
      "      minThroughput: ${6:10000}",
      "    onFail: ${7|stop,continue|}",
      "  - name: \"Cooldown Pause\"",
      "    action: wait",
      "    scenario: \"wait:10s\""
    ]
  },
  "Kates Resilience Chaos Test": {
    "prefix": "kates-resilience",
    "description": "Scaffold a ResilienceTestRequest combining load generation, fault injection, and health probes (kates resilience run -f)",
    "body": [
      "# kates-schema: resilience",
      "testRequest:",
      "  type: ${1|LOAD,INTEGRITY,ENDURANCE,STRESS|}",
      "  spec:",
      "    topic: ${2:kates-resilience}",
      "    partitions: 6",
      "    replicationFactor: 3",
      "    minInsyncReplicas: 2",
      "    numRecords: ${3:300000}",
      "    recordSize: 1024",
      "    throughput: ${4:5000}",
      "    acks: \"all\"",
      "    enableIdempotence: true",
      "chaosSpec:",
      "  experimentName: ${5:broker-pod-kill}",
      "  disruptionType: ${6|POD_KILL,POD_DELETE,GRACEFUL_STOP,NETWORK_PARTITION,NETWORK_LATENCY,DISK_FILL,CPU_STRESS,MEMORY_STRESS,IO_STRESS,DNS_ERROR,ROLLING_RESTART,SCALE_DOWN,LEADER_ELECTION,NODE_DRAIN|}",
      "  targetNamespace: ${7:kafka}",
      "  targetLabel: \"${8:strimzi.io/cluster=krafter,strimzi.io/broker-role=true}\"",
      "  chaosDurationSec: ${9:30}",
      "  delayBeforeSec: ${10:15}",
      "probes:",
      "  - name: no-urp",
      "    type: kafkaProbe",
      "    mode: EOT",
      "    command: under-replicated-partitions",
      "    comparator: \"==\"",
      "    expectedOutput: \"0\"",
      "    intervalSec: 5",
      "    timeoutSec: 10",
      "steadyStateSec: ${11:20}",
      "maxRecoveryWaitSec: ${12:60}"
    ]
  },
  "Kates Disruption Plan / Playbook": {
    "prefix": "kates-disruption",
    "description": "Scaffold a multi-step DisruptionPlan with blast-radius safety guards and ISR/lag tracking (kates disruption run --config)",
    "body": [
      "# kates-schema: disruption",
      "name: ${1:single-broker-failure}",
      "description: \"${2:Verify ISR recovery and latency impact under single broker pod kill}\"",
      "category: ${3|infrastructure,network,compute,storage,operations,kafka,general|}",
      "testType: ${4|LOAD,INTEGRITY,ENDURANCE|}",
      "baselineDurationSec: ${5:30}",
      "maxAffectedBrokers: ${6:1}",
      "autoRollback: true",
      "steps:",
      "  - name: ${7:kill-one-broker}",
      "    steadyStateSec: 20",
      "    observationWindowSec: 90",
      "    requireRecovery: true",
      "    faultSpec:",
      "      experimentName: ${8:broker-pod-kill}",
      "      disruptionType: ${9|POD_KILL,POD_DELETE,GRACEFUL_STOP,NETWORK_PARTITION,NETWORK_LATENCY,DISK_FILL,CPU_STRESS,MEMORY_STRESS,IO_STRESS,DNS_ERROR,ROLLING_RESTART,SCALE_DOWN,LEADER_ELECTION,NODE_DRAIN|}",
      "      targetNamespace: ${10:kafka}",
      "      targetLabel: \"${11:strimzi.io/cluster=krafter,strimzi.io/broker-role=true}\"",
      "      chaosDurationSec: ${12:30}",
      "sla:",
      "  maxRtoMs: ${13:30000}",
      "  maxP99LatencyMs: ${14:50.0}",
      "  maxDataLossPercent: ${15:0.0}"
    ]
  },
  "Kates Compliance Reference (KafkaReference)": {
    "prefix": "kates-compliance",
    "description": "Scaffold a KafkaReference architecture compliance file (kates compliance check -f)",
    "body": [
      "# yaml-language-server: \\$schema=https://raw.githubusercontent.com/bmscomp/kates/main/schemas/kafkareference.v1alpha1.schema.json",
      "apiVersion: conformity.kates.io/v1alpha1",
      "kind: KafkaReference",
      "metadata:",
      "  name: ${1:prod-3az}",
      "  description: \"${2:Production 3-AZ Strimzi Kafka reference architecture}\"",
      "spec:",
      "  versions:",
      "    kubernetes: {min: \"${3:1.29}\"}",
      "    strimzi: {min: \"${4:0.43.0}\"}",
      "    kafka: {min: \"${5:3.8.0}\"}",
      "",
      "  controllers:",
      "    count: 3",
      "    dedicated: true",
      "    zones: {min: 3}",
      "    antiAffinity: required",
      "",
      "  brokers:",
      "    count: {min: ${6:3}}",
      "    requests:",
      "      cpu: {min: \"${7:2}\"}",
      "      memory: {min: \"${8:8Gi}\"}",
      "    storage:",
      "      type: persistent-claim",
      "      size: {min: \"${9:500Gi}\"}",
      "    zones: {min: 3}",
      "    skew: {max: 1}",
      "    perNode: {max: 1}",
      "    antiAffinity: required",
      "",
      "  kafka:",
      "    rackAwareness: true",
      "    authorization: simple",
      "    config:",
      "      min.insync.replicas: {min: 2}",
      "      default.replication.factor: 3",
      "      unclean.leader.election.enable: false",
      "      auto.create.topics.enable: false",
      "",
      "  topics:",
      "    replicationFactor: {min: 3}",
      "    minInsyncReplicas: {min: 2}",
      "",
      "  monitoring:",
      "    metrics: ${10|jmxPrometheusExporter,strimziMetricsReporter|}",
      "    kafkaExporter: true",
      "    podMonitor: true"
    ]
  }
}
