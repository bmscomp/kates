{
  "kubernetes": {
    "version": "1.34",
    "platform": "linux/arm64",
    "gitVersion": "v1.34.0",
    "nodes": [],
    "nodeCount": 4
  },
  "strimzi": {
    "operatorImage": "quay.io/strimzi/operator:1.2.0",
    "version": "1.2.0",
